{
  "name": "one-swagger",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "A fast, clean Swagger UI that can send requests. Universal OpenAPI explorer and API console.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:extension": "node scripts/test-extension.mjs",
    "test:all": "npm run test && npm run build && npm run test:e2e && npm run test:extension",
    "fixtures": "node tests/api/make-fixtures.mjs",
    "api": "node tests/api/server.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "store:assets": "node scripts/build-promo-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "archiver": "^8.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
